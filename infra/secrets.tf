# Secret Manager holds every credential; the repo and this config never hold a value, except the
# migrator's database URL, which Terraform composes because it generated the password (the state
# bucket is readable only by maintainers).

locals {
  # Generated by a maintainer with `openssl rand -base64 32` and added as a version (README).
  app_secrets = toset(concat(
    ["AUTH_SECRET", "RATE_LIMIT_SECRET", "NOTIFICATIONS_DISPATCH_TOKEN", "WORK_ITEMS_SWEEP_TOKEN"],
    tolist(var.provider_secrets),
  ))
}

resource "google_secret_manager_secret" "app" {
  for_each = local.app_secrets

  secret_id = each.value
  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  depends_on = [google_project_service.this]
}

resource "google_secret_manager_secret_iam_member" "app" {
  for_each = google_secret_manager_secret.app

  secret_id = each.value.id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.app.member
}

resource "google_secret_manager_secret" "migrate_database_url" {
  secret_id = "MIGRATE_DATABASE_URL"
  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  depends_on = [google_project_service.this]
}

resource "google_secret_manager_secret_version" "migrate_database_url" {
  secret      = google_secret_manager_secret.migrate_database_url.id
  secret_data = "postgres://${google_sql_user.owner.name}:${random_password.owner.result}@${local.database_host}:5432/${google_sql_database.aluvia.name}?sslmode=require"
}

resource "google_secret_manager_secret_iam_member" "migrate_database_url" {
  secret_id = google_secret_manager_secret.migrate_database_url.id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.migrate.member
}

# The Prometheus sidecar reads its scrape config from a file; Cloud Run mounts files from secrets.
resource "google_secret_manager_secret" "prometheus_config" {
  secret_id = "prometheus-config"
  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  depends_on = [google_project_service.this]
}

resource "google_secret_manager_secret_version" "prometheus_config" {
  secret      = google_secret_manager_secret.prometheus_config.id
  secret_data = templatefile("${path.module}/prometheus.yaml.tftpl", { metrics_port = local.metrics_port })
}

resource "google_secret_manager_secret_iam_member" "prometheus_config" {
  secret_id = google_secret_manager_secret.prometheus_config.id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.app.member
}
