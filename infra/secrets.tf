# Secret Manager holds every credential. Terraform creates each secret and its access; values are
# added with gcloud, so they reach neither this repo nor the Terraform state.

locals {
  # Generated by a maintainer with `openssl rand -base64 32` and added as a version (README).
  app_secrets = toset(concat(
    ["AUTH_SECRET", "RATE_LIMIT_SECRET"],
    tolist(var.provider_secrets),
  ))
}

resource "google_secret_manager_secret" "app" {
  for_each = local.app_secrets

  secret_id = each.value
  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  depends_on = [google_project_service.this]
}

resource "google_secret_manager_secret_iam_member" "app" {
  for_each = google_secret_manager_secret.app

  secret_id = each.value.id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.app.member
}

# The Prometheus sidecar reads its scrape config from a file; Cloud Run mounts files from secrets.
resource "google_secret_manager_secret" "prometheus_config" {
  secret_id = "prometheus-config"
  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  depends_on = [google_project_service.this]
}

resource "google_secret_manager_secret_version" "prometheus_config" {
  secret      = google_secret_manager_secret.prometheus_config.id
  secret_data = templatefile("${path.module}/prometheus.yaml.tftpl", { metrics_port = local.metrics_port })
}

resource "google_secret_manager_secret_iam_member" "prometheus_config" {
  secret_id = google_secret_manager_secret.prometheus_config.id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.app.member
}
