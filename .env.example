# Copy to .env.local. Local values only; real secrets live in GCP Secret Manager.
DATABASE_URL=postgres://aluvia:aluvia@localhost:5440/aluvia
DATABASE_POOL_MAX=5
# Required in production: 32+ random characters, e.g. `openssl rand -base64 32`.
# RATE_LIMIT_SECRET=
TRUSTED_PROXY_HOPS=1
# Optional: enables the coordinators' batch import.
# ANTHROPIC_API_KEY=

# Observability (ADR 0008). Every line is optional: unset, that piece is off and the app works.
# Prometheus scrape port for the Managed Prometheus sidecar. Pick a free one per worktree.
METRICS_PORT=
# GCP project id, so Cloud Logging joins log lines to their trace.
GOOGLE_CLOUD_PROJECT=
# Sentry DSN (browser and server). Source maps upload in CI with SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.
NEXT_PUBLIC_SENTRY_DSN=
# PostHog project key; EU host by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Development only: browse /admin as this user (a platform admin, see pnpm admin:grant).
# DEV_ADMIN_USER_ID=

# Google Maps (ADR 0006, 0011). Without them the app works and the map shows its fallback.
# Dev key: project aluvia-app, restricted to localhost. DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
